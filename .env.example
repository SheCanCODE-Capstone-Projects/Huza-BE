# PostgreSQL
POSTGRES_DB=huza
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# Spring datasource (used by application.properties)
DB_URL=jdbc:postgresql://localhost:5432/huza
DB_USERNAME=postgres
DB_PASSWORD=

# Application
APP_PORT=8016
FRONTEND_URL=http://localhost:3000

# Email
GMAIL_USERNAME=
GMAIL_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8016/login/code/google
